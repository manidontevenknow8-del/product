# ── Google Search Console — striking-distance script ─────────────────────────
#
# Run:  npm run gsc:striking-distance
# Out:  ./src/data/striking-distance.json
#
# Setup:
#   1. Google Cloud Console → APIs & Services → Enable "Google Search Console API"
#   2. IAM → Service Accounts → Create → Keys → Add key → JSON
#   3. Save the JSON somewhere OUTSIDE the repo (e.g. ~/.config/gcp/petclues-gsc.json)
#   4. Google Search Console → Settings → Users and permissions
#      → Add user → paste the service account email → Full permission
#   5. Copy this file to .env and fill in the values below (or export in your shell)

# Absolute path to the service account JSON key file (required).
# Alternative: standard Google env var name also works.
GSC_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/your-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json

# GSC property URL — must match Search Console exactly.
# URL-prefix property (most common):
GSC_SITE_URL=https://petclues.com/
# Domain property alternative:
# GSC_SITE_URL=sc-domain:petclues.com

# Optional: number of targets to output (default 5)
# GSC_TOP_N=5

# ── Google Indexing API — request-google-index / trigger-indexing ────────────
#
# Single URL(s):
#   npm run google:request-index -- https://petclues.com/blog/my-post
#
# Priority batch after SEO deploys (llm.txt + schema):
#   npm run google:trigger-indexing
#   npx tsx scripts/trigger-indexing.ts
#   npx tsx scripts/trigger-indexing.ts --dry-run
#   npx tsx scripts/trigger-indexing.ts --from-sitemap
#
# Setup:
#   1. Google Cloud Console → Enable "Web Search Indexing API"
#   2. Reuse GSC_SERVICE_ACCOUNT_KEY_PATH (same service account JSON key)
#      or place service_account.json at the project root
#   3. Search Console → Settings → Users → add service account as **Owner**
#      (Indexing API requires Owner, not Full user — otherwise HTTP 403)
#
# Quota: ~200 URL publish requests per day per Search Console property.

# ── OpenRouter — generate-blog-faqs script ───────────────────────────────────
#
# Run:  npm run generate:blog-faqs
#       npm run generate:blog-faqs -- --striking-distance
# Out:  ./src/data/generated-faqs.json
#
# Get a key: https://openrouter.ai/keys

OPENROUTER_API_KEY=
# Optional overrides:
# OPENROUTER_FAQ_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://petclues.com
# OPENROUTER_APP_TITLE=PetClues FAQ Generator
# FAQ_GENERATION_DELAY_MS=400

# ── Genesis Vault — /genesis Razorpay checkout ───────────────────────────────
# Requires edge functions: create-genesis-razorpay-order, verify-genesis-razorpay-payment
# VITE_PAYMENTS_ENABLED=true
# VITE_RAZORPAY_KEY_ID=rzp_live_xxx
# Optional hosted link override (skips modal, opens Payment Link URL):
# VITE_GENESIS_RAZORPAY_PAYMENT_LINK=https://rzp.io/rzp/xxxxxxxx

# ── Web push (streak reminders) ───────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# Set matching VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY on Supabase edge secrets.
# VITE_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY (also set on Vercel for production).

# VITE_VAPID_PUBLIC_KEY=
