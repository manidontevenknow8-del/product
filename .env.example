# Supabase - required for real authentication (anon key is public-safe in frontend builds)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge function secrets (set in Supabase Dashboard → Edge Functions → Secrets - never in frontend)
# CRON_SECRET=generate-a-long-random-string
# Must match x-cron-secret header on pg_cron job calling process-email-jobs

# OpenRouter - set in Supabase Edge Function secrets (decode-vet-document)
# OPENROUTER_API_KEY=sk-or-v1-...
# VET_BILL_DECODER_DOCUMENT_MODEL=google/gemini-2.5-flash-lite  # PDF + images (cheapest multimodal)

# Resend - set in Supabase Edge Function secrets (not in frontend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=PetClues <reminders@yourdomain.com>
# APP_BASE_URL=https://petclues.com
# SUPABASE_SERVICE_ROLE_KEY= (auto-injected in edge functions)

# Site URL - canonical domain for SEO (Vercel Production)
# VITE_SITE_URL=https://petclues.com

# PostHog - add to Vercel env vars (NOT Supabase secrets); public project key is safe in frontend
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional demo data toggles (frontend only)
# VITE_DEMO_TIMELINE=true

# Razorpay - public key in Vercel (frontend); secrets in Supabase Edge Functions only
# VITE_RAZORPAY_KEY_ID=rzp_live_...
# VITE_PAYMENTS_ENABLED=true
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# APP_BASE_URL=https://petclues.com
