    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.21.0",
    "nodemailer": "^9.0.3",
    "posthog-js": "^1.382.0",
    "qrcode.react": "^4.2.0",
