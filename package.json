    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "validate:schema": "node scripts/validate-schema-coverage.mjs",
    "validate:links": "node scripts/validate-internal-linking.mjs",
    "generate:sitemaps": "tsx scripts/generate-sitemaps.ts",
    "gsc:striking-distance": "tsx scripts/striking-distance.ts",
    "seed:sandbox": "tsx scripts/seed-sandbox.ts",
    "google:request-index": "tsx scripts/request-google-index.ts",
    "google:trigger-indexing": "tsx scripts/trigger-indexing.ts",
    "seo:indexnow": "tsx scripts/trigger-indexnow.ts",
    "generate:blog-faqs": "tsx scripts/generate-blog-faqs.ts",
    "outreach:dry": "tsx scripts/run-outreach.ts --dry-run",
    "test:household-rls": "./scripts/run-household-rls-tests.sh"
  },
  "dependencies": {
